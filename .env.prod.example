# Copy to .env.prod (gitignored) and fill in. Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
SECRET_KEY=
PUBLIC_URL=https://grants.example.edu     # used in links inside emails
SITE_ADDRESS=grants.example.edu           # Caddy gets a TLS certificate for this name automatically
# SITE_ADDRESS=:80                         # plain HTTP instead (local testing, or another proxy does TLS)
HTTP_PORT=80
HTTPS_PORT=443

# AI features (optional; without a key they answer "not configured")
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_DAILY_LIMIT=50

# Email (alerts and password resets). MAIL_BACKEND=file writes .eml files instead of sending.
MAIL_BACKEND=smtp
MAIL_FROM=GrantLens <alerts@grants.example.edu>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# OpenAlex (paper search). Anonymous use shares a small daily budget per IP address and can run out, which breaks
# paper search, "find grants for my work" and the review builder. A free key (https://help.openalex.org/api/authentication/)
# has its own budget: set it here, never in git.
OPENALEX_API_KEY=
OPENALEX_EMAIL=

# Optional error reporting (needs the `observability` extra built into the image). Queries, bodies, cookies and
# user details are stripped before anything is sent. Leave empty to send nothing.
SENTRY_DSN=
# UV_EXTRAS=--extra observability   # rebuild the image with this set so the Sentry SDK is installed

# Deploying from published images (docker-compose.images.yml, scripts/deploy.sh): the lower-case GitHub owner of the images.
GHCR_OWNER=
WORKER_MEM_LIMIT=2g        # the background worker that builds literature reviews

# Uploaded documents are deleted automatically after this many days (0 = keep forever). Run `flask retention` daily.
RETENTION_DOCUMENT_DAYS=90
