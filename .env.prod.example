# Copy to .env.prod (gitignored) and fill in. Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
SECRET_KEY=
PUBLIC_URL=https://grants.example.edu     # used in links inside emails
SITE_ADDRESS=grants.example.edu           # Caddy gets a TLS certificate for this name automatically
# SITE_ADDRESS=:80                         # plain HTTP instead (local testing, or another proxy does TLS)
HTTP_PORT=80
HTTPS_PORT=443

# AI features (optional; without a key they answer "not configured")
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_DAILY_LIMIT=50

# Email (alerts and password resets). MAIL_BACKEND=file writes .eml files instead of sending.
MAIL_BACKEND=smtp
MAIL_FROM=GrantLens <alerts@grants.example.edu>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional: puts you in OpenAlex's faster "polite" pool
OPENALEX_EMAIL=
