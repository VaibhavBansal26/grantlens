FLASK_ENV=development
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg://grantlens:grantlens@db:5432/grantlens
REDIS_URL=redis://redis:6379/0
# LLM / embedding provider keys go in your local .env only, never in git
LLM_API_KEY=

# Email alerts (`flask send-alerts`, run it on a schedule). Nothing is emailed unless MAIL_BACKEND=smtp.
MAIL_BACKEND=file          # file = write .eml files to MAIL_OUTBOX (dev); smtp = really send
MAIL_OUTBOX=outbox
MAIL_FROM=GrantLens <alerts@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
PUBLIC_URL=http://localhost:3000   # used for links inside emails

# AI answers over uploaded PDFs (OpenAI). Put the real key in your local .env only, never in git or chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini   # any chat model on your account that supports structured outputs
LLM_DAILY_LIMIT=50         # AI requests (document Q&A, fit checks) per user per day
